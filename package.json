{
	"name": "omp-split-view",
	"version": "0.1.0",
	"description": "Split-view TUI extension for oh-my-pi: thinking/tool/files band above the editor, response-only transcript mode",
	"type": "module",
	"scripts": {
		"typecheck": "bun x tsc --noEmit",
		"test": "bun test"
	},
	"license": "MIT",
	"keywords": ["omp-package", "omp", "oh-my-pi", "tui", "split-view", "panels"],
	"files": [
		"split-view.ts",
		"helpers.ts",
		"ui-panels-config.ts",
		"README.md",
		"LICENSE"
	],
	"omp": {
		"extensions": ["./split-view.ts"]
	},
	"pi": {
		"extensions": ["./split-view.ts"]
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=18.0.0",
		"@oh-my-pi/pi-tui": ">=18.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"@types/node": "22",
		"fast-check": "^4.10.2",
		"typescript": "5"
	}
}
