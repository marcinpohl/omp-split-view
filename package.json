{
	"name": "@marcinpohl/omp-split-view",
	"version": "0.1.0",
	"description": "Split-view TUI extension for oh-my-pi: thinking/tool/files band above the editor, response-only transcript mode",
	"type": "module",
	"author": {
		"name": "Marcin Pohl",
		"email": "marcinpohl@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/marcinpohl/omp-split-view.git"
	},
	"homepage": "https://github.com/marcinpohl/omp-split-view#readme",
	"bugs": {
		"url": "https://github.com/marcinpohl/omp-split-view/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"typecheck": "bun x tsc --noEmit",
		"test": "bun test",
		"demo": "bun scripts/demo.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun scripts/check-coverage.ts",
		"check:package": "bun scripts/check-package.ts",
		"prepack": "bun run check:package",
		"prepublishOnly": "bun run check:package"
	},
	"license": "MIT",
	"keywords": [
		"omp-package",
		"omp",
		"oh-my-pi",
		"tui",
		"split-view",
		"panels",
		"plugin",
		"extension"
	],
	"files": [
		"split-view.ts",
		"helpers.ts",
		"ui-panels-config.ts",
		"README.md",
		"LICENSE"
	],
	"omp": {
		"extensions": [
			"./split-view.ts"
		]
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=18.14.2 <19",
		"@oh-my-pi/pi-tui": ">=18.14.2 <19"
	},
	"peerDependenciesMeta": {
		"@oh-my-pi/pi-coding-agent": {
			"optional": true
		},
		"@oh-my-pi/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@oh-my-pi/pi-coding-agent": "18.14.2",
		"@oh-my-pi/pi-tui": "18.14.2",
		"@types/bun": "^1.4.4",
		"@types/node": "22",
		"eslint": "^10.14.0",
		"eslint-plugin-sonarjs": "^4.2.2",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"typescript": "5",
		"typescript-eslint": "^8.72.1"
	}
}
