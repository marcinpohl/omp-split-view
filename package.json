{
	"name": "omp-split-view",
	"version": "0.1.0",
	"description": "Split-view TUI extension for oh-my-pi: thinking/tool/files band above the editor, response-only transcript mode",
	"type": "module",
	"scripts": {
		"typecheck": "bun x tsc --noEmit",
		"test": "bun test",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"license": "MIT",
	"keywords": [
		"omp-package",
		"omp",
		"oh-my-pi",
		"tui",
		"split-view",
		"panels"
	],
	"files": [
		"split-view.ts",
		"helpers.ts",
		"ui-panels-config.ts",
		"README.md",
		"LICENSE"
	],
	"omp": {
		"extensions": [
			"./split-view.ts"
		]
	},
	"pi": {
		"extensions": [
			"./split-view.ts"
		]
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=18.0.0",
		"@oh-my-pi/pi-tui": ">=18.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.4",
		"@types/node": "22",
		"eslint": "^10.14.0",
		"eslint-plugin-sonarjs": "^4.2.2",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"typescript": "5",
		"typescript-eslint": "^8.72.1"
	}
}
